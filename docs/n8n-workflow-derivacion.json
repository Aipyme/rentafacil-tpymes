        },
        "options": {}
      },
      "id": "node_append_sheets",
      "name": "Append Row Google Sheets",
      "type": "n8n-nodes-base.googleSheets",
      "typeVersion": 4,
      "position": [1200, 880],
      "credentials": {
        "googleSheetsOAuth2Api": {
          "id": "PLACEHOLDER_GOOGLE_SHEETS_CREDENTIAL_ID",
          "name": "Google Sheets - Renta Fácil TPymes"
        }
      },
      "notes": "Columnas SIN espacios: telefono, motivo, nif (corregido).\nAñade calendar_event_id, calendar_created_by, assigned_advisor.\nCabeceras fila 1: derivacion_id | expediente_id | nombre | email | telefono | nif | motivo | ahorro_estimado | precio | franja_horaria | reserved_slot | assigned_advisor | estado | calendar_event_id | calendar_created_by | timestamp | notas_asesor | asesor_asignado"
    }
