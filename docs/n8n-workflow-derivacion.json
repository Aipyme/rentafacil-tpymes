{
  "name": "derivacion_handler",
  "nodes": [
    {
      "parameters": {
        "path": "derivacion-create",
        "httpMethod": "POST",
        "responseMode": "onReceived",
        "options": {}
      },
      "id": "node_webhook_trigger",
      "name": "Webhook Trigger",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 1,
      "position": [250, 300],
      "notes": "URL del webhook: https://autogr.app.n8n.cloud/webhook/derivacion-create\nConfigurar esta URL en VITE_WEBHOOK_N8N del proyecto."
    },
    {
      "parameters": {
        "url": "={{ $json[\"body\"][\"expediente_url\"] || `https://rentatpymes.aicheckpyme.co/api/trpc/simulador.getExpediente?input=${encodeURIComponent(JSON.stringify({\"0\":{\"json\":{\"expedienteId\":$json[\"body\"][\"expediente_id\"]}}}))}` }}",
        "options": {
          "timeout": 10000
        }
      },
      "id": "node_get_expediente",
      "name": "Get Expediente",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 1,
      "position": [520, 300],
      "notes": "Obtiene los datos completos del expediente desde la API de Renta Fácil.\nSi el payload ya incluye expediente_url, la usa directamente."
    },
    {
      "parameters": {
        "conditions": {
          "boolean": [
            {
              "value1": "={{ $json[\"body\"][\"es_complejo\"] || $json[\"body\"][\"flag_review\"] }}",
              "operation": "isTrue"
            }
          ]
        }
      },
      "id": "node_if_complejo",
      "name": "IF Es Complejo",
      "type": "n8n-nodes-base.if",
      "typeVersion": 1,
      "position": [760, 300],
      "notes": "Rama TRUE → ejecutar todos los nodos de derivación.\nRama FALSE → no hacer nada (caso simple, ya gestionado por el flujo estándar)."
    },
    {
      "parameters": {
        "operation": "create",
        "resource": "contact",
        "additionalFields": {
          "properties": [
            {
              "name": "email",
              "value": "={{ $json[\"body\"][\"user_contact\"][\"email\"] || $json[\"body\"][\"user_email\"] }}"
            },
            {
              "name": "phone",
              "value": "={{ $json[\"body\"][\"user_contact\"][\"phone\"] }}"
            },
            {
              "name": "firstname",
              "value": "={{ ($json[\"body\"][\"user_contact\"][\"nombre\"] || $json[\"body\"][\"contribuyente\"][\"nombre\"] || '').split(' ')[0] }}"
            },
            {
              "name": "lastname",
              "value": "={{ ($json[\"body\"][\"user_contact\"][\"nombre\"] || $json[\"body\"][\"contribuyente\"][\"nombre\"] || '').split(' ').slice(1).join(' ') }}"
            },
            {
              "name": "notes",
              "value": "={{ `Expediente: ${$json[\"body\"][\"expediente_id\"]}; Motivo: ${$json[\"body\"][\"motivo\"]}; Ahorro estimado: ${$json[\"body\"][\"ahorro_estimado\"]} €; Slot: ${$json[\"body\"][\"reserved_slot\"]}` }}"
            },
            {
              "name": "hs_lead_status",
              "value": "NEW"
            }
          ]
        }
      },
      "id": "node_create_crm_lead",
      "name": "Create CRM Lead",
      "type": "n8n-nodes-base.hubspot",
      "typeVersion": 1,
      "position": [1040, 80],
      "credentials": {
        "hubspotApi": {
          "id": "PLACEHOLDER_HUBSPOT_CREDENTIAL_ID",
          "name": "HubSpot - Renta Fácil TPymes"
        }
      },
      "notes": "Crea contacto en HubSpot con estado NEW.\nSi no usas HubSpot, desactiva este nodo o sustitúyelo por tu CRM."
    },
    {
      "parameters": {
        "authentication": "oAuth2",
        "resource": "event",
        "operation": "create",
        "calendarId": "primary",
        "additionalFields": {
          "summary": "={{ `Revisión Renta - ${$json[\"body\"][\"user_contact\"][\"nombre\"] || $json[\"body\"][\"contribuyente\"][\"nombre\"]} (${$json[\"body\"][\"expediente_id\"]})` }}",
          "description": "={{ `Expediente: ${$json[\"body\"][\"expediente_id\"]}\\nMotivo: ${$json[\"body\"][\"motivo\"]}\\nAhorro estimado: ${$json[\"body\"][\"ahorro_estimado\"]} €\\nPrecio: ${$json[\"body\"][\"precio\"]} €\\nLink admin: https://rentatpymes.aicheckpyme.co/panel-asesor` }}",
          "start": "={{ { dateTime: $json[\"body\"][\"reserved_slot\"] } }}",
          "end": "={{ { dateTime: new Date(new Date($json[\"body\"][\"reserved_slot\"]).getTime() + 60*60000).toISOString() } }}",
          "attendees": [
            {
              "email": "info@ayudatpymes.com"
            }
          ],
          "status": "tentative",
          "sendUpdates": "all"
        }
      },
      "id": "node_create_calendar_event",
      "name": "Create Calendar Event",
      "type": "n8n-nodes-base.googleCalendar",
      "typeVersion": 1,
      "position": [1040, 280],
      "credentials": {
        "googleCalendarOAuth2Api": {
          "id": "PLACEHOLDER_GOOGLE_CALENDAR_CREDENTIAL_ID",
          "name": "Google Calendar - Renta Fácil TPymes"
        }
      },
      "notes": "Crea evento tentative en Google Calendar del asesor.\nDuración: 60 minutos. Notifica al asesor por email automáticamente.\nScopes necesarios: https://www.googleapis.com/auth/calendar.events"
    },
    {
      "parameters": {
        "fromEmail": "noreply@rentatpymes.aicheckpyme.co",
        "toEmail": "={{ $json[\"body\"][\"user_contact\"][\"email\"] || $json[\"body\"][\"contribuyente\"][\"email\"] }}",
        "subject": "Confirmación provisional de cita — Renta Fácil",
        "emailType": "html",
        "message": "=<!DOCTYPE html><html lang=\"es\"><head><meta charset=\"UTF-8\"><style>body{font-family:Arial,sans-serif;background:#f7f5f2;margin:0;padding:0}.container{max-width:560px;margin:40px auto;background:#fff;border-radius:12px;overflow:hidden;box-shadow:0 2px 8px rgba(0,0,0,.08)}.header{background:#1a365d;padding:32px 40px;text-align:center}.header h1{color:#fff;font-size:22px;margin:0}.header p{color:rgba(255,255,255,.7);font-size:14px;margin:8px 0 0}.body{padding:32px 40px}.slot-box{background:#ecfdf5;border:1px solid #6ee7b7;border-radius:8px;padding:16px 20px;margin:20px 0}.slot-box p{margin:0;color:#065f46;font-weight:600;font-size:16px}.slot-box small{color:#047857;font-size:12px}.summary{background:#f8fafc;border-radius:8px;padding:16px 20px;margin:20px 0}.summary table{width:100%;border-collapse:collapse}.summary td{padding:6px 0;font-size:14px;color:#374151}.summary td:first-child{color:#6b7280;width:40%}.summary td:last-child{font-weight:600;color:#111827}.cta{text-align:center;margin:28px 0}.cta a{background:#059669;color:#fff;padding:14px 32px;border-radius:8px;text-decoration:none;font-weight:600;font-size:15px}.footer{background:#f1f5f9;padding:20px 40px;text-align:center}.footer p{color:#94a3b8;font-size:12px;margin:4px 0}</style></head><body><div class=\"container\"><div class=\"header\"><h1>Renta Fácil TPymes</h1><p>Confirmación provisional de cita</p></div><div class=\"body\"><p>Hola <strong>{{ $json[\"body\"][\"contribuyente\"][\"nombre\"] || $json[\"body\"][\"user_contact\"][\"nombre\"] }}</strong>,</p><p>Hemos reservado provisionalmente el siguiente slot para la llamada con tu asesor:</p><div class=\"slot-box\"><p>📅 {{ $json[\"body\"][\"reserved_slot\"] }}</p><small>Estado: Provisional · El asesor confirmará en las próximas horas</small></div><div class=\"summary\"><table><tr><td>Expediente</td><td>{{ $json[\"body\"][\"expediente_id\"] }}</td></tr><tr><td>Motivo</td><td>{{ $json[\"body\"][\"motivo\"] }}</td></tr><tr><td>Ahorro estimado</td><td>{{ $json[\"body\"][\"ahorro_estimado\"] }} €</td></tr><tr><td>Precio estimado</td><td>{{ $json[\"body\"][\"precio\"] }} €</td></tr></table></div><div class=\"cta\"><a href=\"https://rentatpymes.aicheckpyme.co/mi-renta/{{ $json[\"body\"][\"expediente_id\"] }}\">Ver mi expediente</a></div><p style=\"font-size:13px;color:#6b7280\">Recibirás un recordatorio 24h antes y 1h antes de la llamada.</p></div><div class=\"footer\"><p>Renta Fácil TPymes · Ayuda T Pymes</p><p>Este email es una confirmación provisional automática.</p></div></div></body></html>",
        "options": {}
      },
      "id": "node_send_email",
      "name": "Send Email",
      "type": "n8n-nodes-base.emailSend",
      "typeVersion": 2,
      "position": [1040, 480],
      "credentials": {
        "smtp": {
          "id": "PLACEHOLDER_SMTP_CREDENTIAL_ID",
          "name": "SMTP - Renta Fácil TPymes"
        }
      },
      "notes": "Email HTML de confirmación provisional al cliente.\nSMTP recomendado: Brevo (smtp-relay.brevo.com:587) — 300 emails/día gratis."
    },
    {
      "parameters": {
        "channel": "#asesores",
        "text": "={{ `🔔 *Nuevo caso derivado: ${$json[\"body\"][\"derivacion_id\"]}*\\n\\n*Cliente:* ${$json[\"body\"][\"contribuyente\"][\"nombre\"] || $json[\"body\"][\"user_contact\"][\"nombre\"]} (${$json[\"body\"][\"user_contact\"][\"email\"]})\\n*NIF:* ${$json[\"body\"][\"user_contact\"][\"nif\"]}\\n*Teléfono:* ${$json[\"body\"][\"user_contact\"][\"phone\"]}\\n*Motivo:* ${$json[\"body\"][\"motivo\"]}\\n*Ahorro estimado:* ${$json[\"body\"][\"ahorro_estimado\"]} €\\n*Precio:* ${$json[\"body\"][\"precio\"]} €\\n*Slot reservado:* ${$json[\"body\"][\"reserved_slot\"]}\\n*Expediente:* ${$json[\"body\"][\"expediente_id\"]}\\n\\n<https://rentatpymes.aicheckpyme.co/panel-asesor|🔗 Ver en panel de asesores>` }}",
        "otherOptions": {}
      },
      "id": "node_slack_notify",
      "name": "Slack Notify",
      "type": "n8n-nodes-base.slack",
      "typeVersion": 1,
      "position": [1040, 680],
      "credentials": {
        "slackApi": {
          "id": "PLACEHOLDER_SLACK_CREDENTIAL_ID",
          "name": "Slack - Renta Fácil TPymes"
        }
      },
      "notes": "Notifica al canal #asesores en Slack.\nAlternativa: usar nodo HTTP Request con Incoming Webhook URL."
    },
    {
      "parameters": {
        "authentication": "oAuth2",
        "operation": "append",
        "documentId": {
          "__rl": true,
          "value": "PLACEHOLDER_SHEETS_ID",
          "mode": "id"
        },
        "sheetName": {
          "__rl": true,
          "value": "Derivaciones",
          "mode": "name"
        },
        "columns": {
          "mappingMode": "defineBelow",
          "value": {
            "derivacion_id": "={{ $json[\"body\"][\"derivacion_id\"] }}",
            "expediente_id": "={{ $json[\"body\"][\"expediente_id\"] }}",
            "nombre": "={{ $json[\"body\"][\"contribuyente\"][\"nombre\"] || $json[\"body\"][\"user_contact\"][\"nombre\"] }}",
            "email": "={{ $json[\"body\"][\"user_contact\"][\"email\"] }}",
            "telefono": "={{ $json[\"body\"][\"user_contact\"][\"phone\"] }}",
            "nif": "={{ $json[\"body\"][\"user_contact\"][\"nif\"] }}",
            "motivo": "={{ $json[\"body\"][\"motivo\"] }}",
            "ahorro_estimado": "={{ $json[\"body\"][\"ahorro_estimado\"] }}",
            "precio": "={{ $json[\"body\"][\"precio\"] }}",
            "franja_horaria": "={{ $json[\"body\"][\"franja_horaria\"] }}",
            "reserved_slot": "={{ $json[\"body\"][\"reserved_slot\"] }}",
            "estado": "pending",
            "timestamp": "={{ new Date().toLocaleString('es-ES', {timeZone: 'Europe/Madrid'}) }}",
            "calendar_event_id": "={{ $('Create Calendar Event').item.json.id || '' }}",
            "notas_asesor": "",
            "asesor_asignado": ""
          }
        },
        "options": {}
      },
      "id": "node_append_sheets",
      "name": "Append Row Google Sheets",
      "type": "n8n-nodes-base.googleSheets",
      "typeVersion": 4,
      "position": [1040, 880],
      "credentials": {
        "googleSheetsOAuth2Api": {
          "id": "PLACEHOLDER_GOOGLE_SHEETS_CREDENTIAL_ID",
          "name": "Google Sheets - Renta Fácil TPymes"
        }
      },
      "notes": "Añade fila a la hoja 'Derivaciones' del Google Sheet.\nColumnas: derivacion_id, expediente_id, nombre, email, telefono, nif, motivo, ahorro_estimado, precio, franja_horaria, reserved_slot, estado, timestamp, calendar_event_id, notas_asesor, asesor_asignado"
    }
  ],
  "connections": {
    "Webhook Trigger": {
      "main": [
        [
          {
            "node": "Get Expediente",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Get Expediente": {
      "main": [
        [
          {
            "node": "IF Es Complejo",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "IF Es Complejo": {
      "main": [
        [
          {
            "node": "Create CRM Lead",
            "type": "main",
            "index": 0
          },
          {
            "node": "Create Calendar Event",
            "type": "main",
            "index": 0
          },
          {
            "node": "Send Email",
            "type": "main",
            "index": 0
          },
          {
            "node": "Slack Notify",
            "type": "main",
            "index": 0
          },
          {
            "node": "Append Row Google Sheets",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1",
    "saveManualExecutions": true,
    "callerPolicy": "workflowsFromSameOwner"
  },
  "staticData": null,
  "meta": {
    "templateCredsSetupCompleted": false
  },
  "pinData": {},
  "tags": ["renta-facil", "derivacion", "asesor"]
}
