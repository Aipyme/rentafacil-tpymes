{
  "name": "derivacion_handler",
  "nodes": [
    {
      "parameters": {
        "path": "derivacion-create",
        "httpMethod": "POST",
        "responseMode": "onReceived",
        "options": {}
      },
      "id": "node_webhook_trigger",
      "name": "Webhook Trigger",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 1,
      "position": [250, 300],
      "notes": "URL: https://autogr.app.n8n.cloud/webhook/derivacion-create\nConfigurar VITE_WEBHOOK_N8N en el proyecto con esta URL."
    },
    {
      "parameters": {
        "conditions": {
          "string": [
            {
              "value1": "={{ $json[\"headers\"][\"x-webhook-key\"] }}",
              "operation": "equals",
              "value2": "={{$env.WEBHOOK_SECRET_KEY}}"
            }
          ]
        }
      },
      "id": "node_validate_key",
      "name": "Validate Webhook Key",
      "type": "n8n-nodes-base.if",
      "typeVersion": 1,
      "position": [480, 300],
      "notes": "Valida la cabecera X-Webhook-Key contra la variable de entorno WEBHOOK_SECRET_KEY.\nSi no coincide, el flujo se detiene (rama FALSE no tiene conexiones).\nPara MVP puedes desactivar este nodo si no usas clave todavía."
    },
    {
      "parameters": {
        "url": "={{ $json[\"body\"][\"expediente_url\"] || `https://rentatpymes.aicheckpyme.co/api/trpc/simulador.getExpediente?input=${encodeURIComponent(JSON.stringify({\"0\":{\"json\":{\"expedienteId\":$json[\"body\"][\"expediente_id\"]}}}))}` }}",
        "options": {
          "timeout": 10000
        }
      },
      "id": "node_get_expediente",
      "name": "Get Expediente",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 1,
      "position": [720, 300],
      "notes": "Obtiene datos completos del expediente desde la API.\nSi el payload ya incluye expediente_url, la usa directamente.\nTimeout: 10s."
    },
    {
      "parameters": {
        "conditions": {
          "boolean": [
            {
              "value1": "={{ $json[\"body\"][\"es_complejo\"] || $json[\"body\"][\"flag_review\"] }}",
              "operation": "isTrue"
            }
          ]
        }
      },
      "id": "node_if_complejo",
      "name": "IF Es Complejo",
      "type": "n8n-nodes-base.if",
      "typeVersion": 1,
      "position": [960, 300],
      "notes": "Rama TRUE → ejecutar todos los nodos de derivación.\nRama FALSE → no hacer nada (caso simple)."
    },
    {
      "parameters": {
        "operation": "create",
        "resource": "contact",
        "additionalFields": {
          "properties": [
            {
              "name": "email",
              "value": "={{ $json[\"body\"][\"user_contact\"][\"email\"] || $json[\"body\"][\"user_email\"] }}"
            },
            {
              "name": "phone",
              "value": "={{ $json[\"body\"][\"user_contact\"][\"phone\"] }}"
            },
            {
              "name": "firstname",
              "value": "={{ ($json[\"body\"][\"user_contact\"][\"nombre\"] || $json[\"body\"][\"contribuyente\"][\"nombre\"] || '').split(' ')[0] }}"
            },
            {
              "name": "lastname",
              "value": "={{ ($json[\"body\"][\"user_contact\"][\"nombre\"] || $json[\"body\"][\"contribuyente\"][\"nombre\"] || '').split(' ').slice(1).join(' ') }}"
            },
            {
              "name": "notes",
              "value": "={{ `Expediente: ${$json[\"body\"][\"expediente_id\"]}; Motivo: ${$json[\"body\"][\"motivo\"]}; Ahorro: ${$json[\"body\"][\"ahorro_estimado\"]} €; Slot: ${$json[\"body\"][\"reserved_slot\"]}` }}"
            },
            {
              "name": "hs_lead_status",
              "value": "NEW"
            }
          ]
        }
      },
      "id": "node_create_crm_lead",
      "name": "Create CRM Lead",
      "type": "n8n-nodes-base.hubspot",
      "typeVersion": 1,
      "position": [1200, 80],
      "disabled": true,
      "credentials": {
        "hubspotApi": {
          "id": "PLACEHOLDER_HUBSPOT_CREDENTIAL_ID",
          "name": "HubSpot - Renta Fácil TPymes"
        }
      },
      "notes": "DESACTIVADO por defecto. Activar cuando se configure HubSpot.\nSustituir por el CRM que uses si no es HubSpot."
    },
    {
      "parameters": {
        "authentication": "oAuth2",
        "resource": "event",
        "operation": "create",
        "calendarId": "c_fad4d5afc9e665e79f3278b4b9c3c520d17be52439ca665f015edfb3c57eee88@group.calendar.google.com",
        "additionalFields": {
          "attendees": [
            {
              "email": "={{ $json[\"body\"][\"assigned_advisor_email\"] || $json[\"body\"][\"advisor_email\"] || 'asesor@ayudatpymes.com' }}"
            }
          ],
          "description": "={{ `Expediente: ${$json[\"body\"][\"expediente_id\"]}\\nMotivo: ${$json[\"body\"][\"motivo\"]}\\nAhorro estimado: ${$json[\"body\"][\"ahorro_estimado\"]} €\\nPrecio: ${$json[\"body\"][\"precio\"]} €\\nLink admin: https://rentatpymes.aicheckpyme.co/panel-asesor` }}",
          "sendUpdates": "all",
          "summary": "={{ `Revisión Renta - ${$json[\"body\"][\"user_contact\"][\"nombre\"] || $json[\"body\"][\"contribuyente\"][\"nombre\"]} (${$json[\"body\"][\"expediente_id\"]})` }}",
          "start": "={{ { dateTime: new Date($json[\"body\"][\"reserved_slot\"]).toISOString() } }}",
          "end": "={{ new Date(new Date($json[\"body\"][\"reserved_slot\"]).getTime() + 60*60000).toISOString() }}",
          "status": "tentative"
        }
      },
      "id": "node_create_calendar_event",
      "name": "Create Calendar Event",
      "type": "n8n-nodes-base.googleCalendar",
      "typeVersion": 1,
      "position": [1200, 280],
      "credentials": {
        "googleCalendarOAuth2Api": {
          "id": "PLACEHOLDER_GOOGLE_CALENDAR_CREDENTIAL_ID",
          "name": "Google Calendar - Renta Fácil TPymes"
        }
      },
      "notes": "Crea evento tentative en el calendario compartido 'Citas Renta Fácil'.\nAttendee dinámico: usa assigned_advisor_email del payload (fallback a info@ayudatpymes.com).\nDuración: 60 minutos. sendUpdates: all → notifica al asesor por email."
    },
    {
      "parameters": {
        "fromEmail": "noreply@ecombriefs.ai",
        "toEmail": "={{ $json[\"body\"][\"user_contact\"][\"email\"] || $json[\"body\"][\"contribuyente\"][\"email\"] }}",
        "subject": "Confirmación provisional de cita — Renta Fácil",
        "emailType": "html",
        "message": "=<!DOCTYPE html><html lang=\"es\"><head><meta charset=\"UTF-8\"><style>body{font-family:Arial,sans-serif;background:#f7f5f2;margin:0;padding:0}.container{max-width:560px;margin:40px auto;background:#fff;border-radius:12px;overflow:hidden;box-shadow:0 2px 8px rgba(0,0,0,.08)}.header{background:#1a365d;padding:32px 40px;text-align:center}.header h1{color:#fff;font-size:22px;margin:0}.header p{color:rgba(255,255,255,.7);font-size:14px;margin:8px 0 0}.body{padding:32px 40px}.slot-box{background:#ecfdf5;border:1px solid #6ee7b7;border-radius:8px;padding:16px 20px;margin:20px 0}.slot-box p{margin:0;color:#065f46;font-weight:600;font-size:16px}.slot-box small{color:#047857;font-size:12px}.summary{background:#f8fafc;border-radius:8px;padding:16px 20px;margin:20px 0}.summary table{width:100%;border-collapse:collapse}.summary td{padding:6px 0;font-size:14px;color:#374151}.summary td:first-child{color:#6b7280;width:40%}.summary td:last-child{font-weight:600;color:#111827}.cta{text-align:center;margin:28px 0}.cta a{background:#059669;color:#fff;padding:14px 32px;border-radius:8px;text-decoration:none;font-weight:600;font-size:15px}.footer{background:#f1f5f9;padding:20px 40px;text-align:center}.footer p{color:#94a3b8;font-size:12px;margin:4px 0}</style></head><body><div class=\"container\"><div class=\"header\"><h1>Renta Fácil TPymes</h1><p>Confirmación provisional de cita</p></div><div class=\"body\"><p>Hola <strong>{{ $json.body.contribuyente.nombre || $json.body.user_contact.nombre }}</strong>,</p><p>Hemos reservado provisionalmente el siguiente slot para la llamada con tu asesor:</p><div class=\"slot-box\"><p>📅 {{ $json.body.reserved_slot }}</p><small>Estado: Provisional · El asesor confirmará en las próximas horas</small></div><div class=\"summary\"><table><tr><td>Expediente</td><td>{{ $json.body.expediente_id || $json.body.derivacion_id }}</td></tr><tr><td>Motivo</td><td>{{ $json.body.motivo }}</td></tr><tr><td>Ahorro estimado</td><td>{{ $json.body.ahorro_estimado }} €</td></tr><tr><td>Precio estimado</td><td>{{ $json.body.precio }} €</td></tr></table></div><div class=\"cta\"><a href=\"https://rentatpymes.aicheckpyme.co\">Ver mi expediente</a></div><p style=\"font-size:13px;color:#6b7280\">Recibirás un recordatorio 24h antes y 1h antes de la llamada.</p><p style=\"font-size:12px;color:#9ca3af\">¿Necesitas cambiar la cita? Responde a este email o llámanos.</p></div><div class=\"footer\"><p>Renta Fácil TPymes · Ayuda T Pymes</p><p>Este email es una confirmación provisional automática.</p></div></div></body></html>",
        "options": {}
      },
      "id": "node_send_email",
      "name": "Send Email",
      "type": "n8n-nodes-base.emailSend",
      "typeVersion": 2,
      "position": [1200, 480],
      "credentials": {
        "smtp": {
          "id": "PLACEHOLDER_SMTP_CREDENTIAL_ID",
          "name": "SMTP Brevo - Renta Fácil TPymes"
        }
      },
      "notes": "Email HTML de confirmación provisional al cliente.\nIncluye link para cancelar/reprogramar (responder al email).\nSMTP: Brevo smtp-relay.brevo.com:587"
    },
    {
      "parameters": {
        "channel": "#asesores",
        "text": "={{ `🔔 *Nuevo caso derivado: ${$json[\"body\"][\"derivacion_id\"]}*\\n\\n*Cliente:* ${$json[\"body\"][\"contribuyente\"][\"nombre\"] || $json[\"body\"][\"user_contact\"][\"nombre\"]} (${$json[\"body\"][\"user_contact\"][\"email\"]})\\n*NIF:* ${$json[\"body\"][\"user_contact\"][\"nif\"]}\\n*Teléfono:* ${$json[\"body\"][\"user_contact\"][\"phone\"]}\\n*Motivo:* ${$json[\"body\"][\"motivo\"]}\\n*Ahorro estimado:* ${$json[\"body\"][\"ahorro_estimado\"]} €\\n*Precio:* ${$json[\"body\"][\"precio\"]} €\\n*Slot reservado:* ${$json[\"body\"][\"reserved_slot\"]}\\n*Asesor asignado:* ${$json[\"body\"][\"assigned_advisor_email\"] || 'Por asignar'}\\n\\n<https://rentatpymes.aicheckpyme.co/panel-asesor|🔗 Ver en panel de asesores>` }}",
        "otherOptions": {}
      },
      "id": "node_slack_notify",
      "name": "Slack Notify",
      "type": "n8n-nodes-base.slack",
      "typeVersion": 1,
      "position": [1200, 680],
      "disabled": true,
      "credentials": {
        "slackApi": {
          "id": "PLACEHOLDER_SLACK_CREDENTIAL_ID",
          "name": "Slack - Renta Fácil TPymes"
        }
      },
      "notes": "DESACTIVADO por defecto. Activar cuando se configure Slack.\nMuestra assigned_advisor_email en el mensaje."
    },
    {
