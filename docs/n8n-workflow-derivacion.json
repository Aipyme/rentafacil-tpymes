            "timestamp": "={{ new Date().toLocaleString('es-ES', {timeZone: 'Europe/Madrid'}) }}",
            "calendar_event_id": "={{ $('Create Calendar Event').item.json.id || '' }}",
            "calendar_created_by": "shared_calendar",
            "asesor_asignado": "={{ $json[\"body\"][\"assigned_advisor_email\"] || 'Por asignar' }}",
            "notas_asesor": ""
          },
          "schema": [
            {"id":"derivacion_id","displayName":"derivacion_id","type":"string"},
