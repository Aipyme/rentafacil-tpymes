          "value": {
            "derivacion_id": "={{ $json[\"body\"][\"derivacion_id\"] }}",
            "expediente_id": "={{ $json[\"body\"][\"expediente_id\"] }}",
            "nombre": "={{ $json[\"body\"][\"contribuyente\"][\"nombre\"] || $json[\"body\"][\"user_contact\"][\"nombre\"] }}",
            "email": "={{ $json[\"body\"][\"user_contact\"][\"email\"] }}",
            "telefono": "={{ $json[\"body\"][\"user_contact\"][\"phone\"] }}",
            "nif": "={{ $json[\"body\"][\"user_contact\"][\"nif\"] }}",
            "motivo": "={{ $json[\"body\"][\"motivo\"] }}",
            "ahorro_estimado": "={{ $json[\"body\"][\"ahorro_estimado\"] }}",
            "precio": "={{ $json[\"body\"][\"precio\"] }}",
            "franja_horaria": "={{ $json[\"body\"][\"franja_horaria\"] }}",
            "reserved_slot": "={{ $json[\"body\"][\"reserved_slot\"] }}",
